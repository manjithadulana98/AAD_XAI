    <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6B85AB;strokeWidth=2;" edge="1" source="bh" target="flag_perm" parent="1">
      <mxGeometry relative="1" as="geometry" />
