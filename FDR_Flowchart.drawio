    <!-- flags → combo (merge) -->
    <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=#6B85AB;strokeWidth=2;" edge="1" source="flag_occ" target="combo" parent="1">
      <mxGeometry relative="1" as="geometry" />
